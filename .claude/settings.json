{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm publish:*)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(gate/**)",
      "Edit(config/**)",
      "Edit(scripts/**)",
      "Edit(public/**)",
      "Edit(CLAUDE.md)",
      "Edit(package.json)",
      "Edit(package-lock.json)"
    ]
  },
  "disableAllHooks": true,
  "enableAllProjectMcpServers": false
}
